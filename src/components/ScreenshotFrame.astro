---
import Icon from "./Icon.astro";
import type { Screenshot } from "../data/showcase";
interface Props {
  shot: Screenshot;
  id: string;
  eager?: boolean;
}
const { shot, id, eager = false } = Astro.props;
---

<div class:list={["app-window", { "app-window-light": shot.chromeInset === 0 && !shot.nativeChrome, "app-window-native": shot.nativeChrome }]}>
  {!shot.nativeChrome && (
    <div class="window-titlebar">
      <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="window-title">devcroft <span>/</span> {shot.tab}</span>
      <span class="window-symbol" aria-hidden="true"><Icon name={shot.icon} size={15} /></span>
    </div>
  )}
  <button
    class="screenshot-open"
    data-screenshot={id}
    aria-haspopup="dialog"
    aria-controls={`screenshot-${id}`}
    aria-label={`Enlarge ${shot.tab.toLowerCase()} ${shot.placeholder ? "illustration" : "screenshot"}`}
  >
    <span class="screenshot-viewport">
      <img
        src={shot.src}
        alt={shot.alt}
        width={shot.width}
        height={shot.height}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        style={shot.chromeInset ? `margin-top: -${shot.chromeInset}%` : undefined}
      />
    </span>
    <span class="screenshot-enlarge"><Icon name="expand" size={14} /> Enlarge</span>
  </button>
</div>
<dialog class="screenshot-dialog" id={`screenshot-${id}`} aria-labelledby={`screenshot-title-${id}`}>
  <div class="screenshot-dialog-top">
    <div>
      <h2 id={`screenshot-title-${id}`}>{shot.tab}</h2>
      <p>{shot.placeholder ? "Illustrative preview · not a real app capture" : "Captured in Devcroft"}</p>
    </div>
    <form method="dialog">
      <button aria-label="Close screenshot" autofocus><Icon name="close" size={20} /></button>
    </form>
  </div>
  <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" />
</dialog>
